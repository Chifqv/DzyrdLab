                                <span class="avatar avatar--wine">АД</span>
                                <span class="author-name">Агунда Дзагоева<small>учитель осетинского языка</small></span>
                            </div>
                            <div class="meta">
                                <span class="rating"><svg class="icon icon--fill" aria-hidden="true"><use href="#i-star" /></svg> 4.9 <i>(32)</i></span>
                                <span class="meta-sep" aria-hidden="true"></span>
                                <span>1 248 скачиваний</span>
                                <span class="meta-right">24 стр.</span>
                            </div>
                        </div>
                    </article>

                    <article class="material" data-cat="worksheet" data-grade="primary" data-keywords="ӕ буква алфавит письмо чтение 2 класс рабочий лист рабочие листы письменность фонетика диагностика" data-reveal>
