@{
    ViewData["Title"] = "Home Page";
}

<body>
    

    <main id="main">
        <section class="hero" id="top">
            <div class="shell hero-grid">
                <div class="hero-copy">
                    <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Методическая библиотека · <span lang="os">Ирон æвзаг</span></p>
                    <h1>Уроки осетинского <span class="accent">начинаются здесь</span>.</h1>
                    <p class="hero-lead">Разработки, рабочие листы и игры от практикующих педагогов — для учителей, воспитателей и родителей. Найдите материал по теме и классу, скачайте и обсудите с коллегами.</p>

                    <form class="search" id="hero-search" role="search" novalidate>
                        <svg class="icon search-icon" aria-hidden="true"><use href="#i-search" /></svg>
                        <label class="sr-only" for="search-input">Поиск по материалам</label>
                        <input id="search-input" name="q" type="search" placeholder="Тема, класс или автор…" autocomplete="off">
                        <button class="btn btn-search" type="submit">Найти</button>
                    </form>

                    <div class="quick-filters" aria-label="Быстрый подбор материалов">
                        <span class="quick-label">Часто ищут:</span>
                        <button class="chip" type="button" data-catalog-query="Нартский эпос">Нартский эпос</button>
                        <button class="chip" type="button" data-catalog-type="worksheet">Рабочие листы</button>
                        <button class="chip" type="button" data-catalog-grade="preschool">Дошкольникам</button>
                        <button class="chip" type="button" data-catalog-type="game">Игры</button>
                    </div>

                    <dl class="hero-stats">
                        <div class="stat"><dt>материалов</dt><dd>2 480</dd></div>
                        <div class="stat"><dt>авторов</dt><dd>640</dd></div>
                        <div class="stat"><dt>скачиваний</dt><dd>19 400</dd></div>
                    </dl>
                </div>

                <div class="hero-art" aria-hidden="true">
                    <div class="art-stage">
                        <div class="art-arch">
                            <span class="art-arch-glyph">Æ</span>
                            <span class="art-arch-word" lang="os">iron ævzag</span>
                        </div>
                        <div class="paper paper-back"></div>
                        <div class="paper paper-main">
                            <div class="paper-head">
                                <span class="paper-kicker">Методическая разработка</span>
                                <span class="paper-badge">8 класс</span>
                            </div>
                            <div class="paper-title">Нартский эпос:<br>герои и смыслы</div>
                            <div class="paper-cover">
                                <span class="paper-cover-glyph">Æ</span>
                                <span class="paper-cover-caption">Литература · 45 минут</span>
                            </div>
                            <div class="paper-lines"><i></i><i></i><i></i></div>
                            <div class="paper-list">
                                <span><i class="paper-check"></i> Конспект урока</span>
                                <span><i class="paper-check"></i> Презентация · 12 слайдов</span>
                            </div>
                            <div class="paper-foot"><span>DzyrdLab</span><span>24 страницы</span></div>
                        </div>
                        <div class="float-verified">
                            <span class="float-icon"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg></span>
                            <span><strong>Проверено рецензентом</strong><small>методист · кандидат наук</small></span>
                        </div>
                        <div class="float-stat">
                            <span class="float-icon float-icon--wine"><svg class="icon" aria-hidden="true"><use href="#i-download" /></svg></span>
                            <span><strong>1 248</strong><small>скачиваний за неделю</small></span>
                            <span class="mini-bars"><i></i><i></i><i></i><i></i><i></i></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="shell trust-bar">
                <span class="trust-item"><svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg> Каждый материал проверяет рецензент</span>
                <span class="trust-item"><svg class="icon" aria-hidden="true"><use href="#i-download" /></svg> Скачивание без регистрации</span>
                <span class="trust-item"><svg class="icon" aria-hidden="true"><use href="#i-scale" /></svg> Права остаются у автора</span>
            </div>
        </section>

        <section class="section section--classes" id="classes">
            <div class="shell">
                <div class="section-head" data-reveal>
                    <div>
                        <p class="eyebrow"><span class="eyebrow-index">01</span> Навигация</p>
                        <h2>Начните с класса</h2>
                    </div>
                    <a class="link-arrow" href="catalog.html">Вся библиотека <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg></a>
                </div>

                <div class="class-grid">
                    <a class="class-card" href="catalog.html?grade=preschool" data-reveal>
                        <span class="class-icon"><svg class="icon" aria-hidden="true"><use href="#i-sparkles" /></svg></span>
                        <span class="class-num">01</span>
                        <h3>Дошкольникам</h3>
                        <p>Игры, карточки и занятия для самых маленьких</p>
                        <span class="class-foot">184 материала <svg class="icon" aria-hidden="true"><use href="#i-arrow-up-right" /></svg></span>
                    </a>
                    <a class="class-card" href="catalog.html?grade=primary" data-reveal>
                        <span class="class-icon"><svg class="icon" aria-hidden="true"><use href="#i-pencil" /></svg></span>
                        <span class="class-num">02</span>
                        <h3>1–4 классы</h3>
                        <p>Первые слова, письмо и любовь к языку</p>
                        <span class="class-foot">612 материалов <svg class="icon" aria-hidden="true"><use href="#i-arrow-up-right" /></svg></span>
                    </a>
                    <a class="class-card" href="catalog.html?grade=middle" data-reveal>
                        <span class="class-icon"><svg class="icon" aria-hidden="true"><use href="#i-book" /></svg></span>
                        <span class="class-num">03</span>
                        <h3>5–9 классы</h3>
                        <p>Грамматика, тексты и живой разговор</p>
                        <span class="class-foot">894 материала <svg class="icon" aria-hidden="true"><use href="#i-arrow-up-right" /></svg></span>
                    </a>
                    <a class="class-card" href="catalog.html?grade=high" data-reveal>
                        <span class="class-icon"><svg class="icon" aria-hidden="true"><use href="#i-cap" /></svg></span>
                        <span class="class-num">04</span>
                        <h3>10–11 классы</h3>
                        <p>Литература, анализ и подготовка к экзаменам</p>
                        <span class="class-foot">438 материалов <svg class="icon" aria-hidden="true"><use href="#i-arrow-up-right" /></svg></span>
                    </a>
                </div>
            </div>
        </section>

        <section class="section section--library" id="library">
